}
<function>
mirrorAxisFormatter^^'formatter' : function(){
    // This removes the negative sign from the X-axis labels.
    return this.value;
}
##
mirrorDataLabelFormatter^^'formatter' : function(){
    // Shows absolute positive value on the green bar ends natively.
    return Math.abs(this.value);
}
##
mirrorTooltip^^'formatter' : function() {
    if (!this || !this.point) { return false; }
    var name = this.point.agency || '';
    return '<span>' + name + ' - ' + this.point.agency_name +'</span>';
}
</function>
