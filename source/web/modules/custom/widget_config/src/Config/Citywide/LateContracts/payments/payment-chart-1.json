<function>yAxisFormatter^^'formatter' : function() {
  if (Number.isInteger(this.value)) {
    return Highcharts.numberFormat(this.value, 0, '.', ',');
  }
  else {
    // SKip y-axis label for fractions
    return '';
  }
}##
tooltipFormatter^^"formatter" : function() {
  if (this.y == 0) {
    return FALSE;
  }
  return 'First Check Payment Delay Category: '+ this.point.name + 
  '<br># of Unique Contracts: ' + (this.y).toLocaleString() + 
  '<br>Total Check Amount: ' + abbrNum(this.point.total_check_amount_sum, 2, '$') + 
  '<br># of Unique Vendors: ' + (this.point.unique_vendor_count).toLocaleString();
}
##
seriesLabelFormatter^^'formatter' : function () {
if (this.y == null) {
  return '';
}
return Highcharts.numberFormat(this.y, 0, '.', ',');
}
</function>
