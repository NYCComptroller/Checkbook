    "vendor": "vendor_customer_code.vendor_customer_code",
    "mwbe": "minority_type_id.minority_type_id",
    "industry": "industry_type_id.industry_type_id",
    "mayoral_flag" : "mayoral_flag"
  },
  "adjustParameters": "
    return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->adjustParametersFor($parameters, 'contract-volume-chart-1');",
  "transformationPHP": "
    return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->transformationPHPFor('contract-volume-chart-1', $node);
  ",
  "chartConfig": {
