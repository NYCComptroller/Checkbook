      "margin": 0,
      "y": 5,
      "x": -20,
      "itemStyle": {
        "color": "#000",
        "fontWeight": "normal",
        "fontSize": "12px",
        "fontFamily": "Roboto, sans-serif"
      },
      "symbolWidth": 12,
      "symbolHeight": 12
    },
    "xAxis": {
      "categories": [],
      "lineColor": "#ccd6eb",
      "tickWidth": 0,
      "title": {
        "text": "Fiscal Year",
        "style": {
          "fontSize": "12px",
          "color": "#000",
          "fontFamily": "Roboto, sans-serif",
          "fontWeight": "normal"
        },
        "align": "middle",
        "x": -35,
        "offset": 30
      },
      "labels": {
        "enabled": true,
        "style": {
          "fontSize": "12px",
          "color": "#000",
          "fontFamily": "Roboto, sans-serif",
          "fontWeight": "normal"
        },
        "y": 20
      }
    },
    "yAxis": {
