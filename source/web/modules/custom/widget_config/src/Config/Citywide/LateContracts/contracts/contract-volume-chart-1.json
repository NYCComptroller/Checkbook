<function>yAxisFormatter^^'formatter' : function() {
  return this.axis.chart.series[0].visible || this.axis.chart.series[1].visible ? Highcharts.numberFormat(this.value, 0, '.', ',') : '';
}##
tooltipFormatter^^"formatter" : function() {
  if (!this.points[0].point.count_total) {
    return false;
  }
  var onTime = 0;
  var late = 0;

  this.points.forEach(function (p) {
    if (p.series.name === 'On Time') {
    onTime = p.y;
    } else if (p.series.name === 'Late') {
    late = p.y;
    }
  });
  return 'Year: '+ this.point.year + '<br/>' +
  'On Time: ' + onTime.toLocaleString() + '<br/>' +
  'Late: ' + late.toLocaleString() + '<br/>' +
  'Total Contract Volume: ' + (this.points[0].point.count_total).toLocaleString();
}
##
seriesLabelFormatter^^'formatter' : function () {
if (this.series.name === 'No Data') {
return (
  false === this.series.chart.series[0].visible ||
  false === this.series.chart.series[1].visible
  ) ? '' : '0';
}
if (this.y == null) {
  return '';
}
return Highcharts.numberFormat(this.y, 0, '.', ',');
}
</function>
