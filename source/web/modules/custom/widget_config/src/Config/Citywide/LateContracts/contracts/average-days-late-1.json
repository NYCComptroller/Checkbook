avgDaysLateYAxisFormatter^^'formatter' : function() {
var labelMap = this.axis.options.axisLabelMap || {};
var key = String(this.value);
var mappedValue = typeof labelMap[key] !== 'undefined' ? labelMap[key] : this.value;
return Highcharts.numberFormat(mappedValue, 0, '.', ',');
}##

avgDaysLateDataLabelFormatter^^'formatter' : function(){
if (this.y === null || typeof this.y === 'undefined') {
return '';
}
var value = typeof this.point.actualValue !== 'undefined' ? this.point.actualValue : this.y;
return Highcharts.numberFormat(value, 0, '.', ',');
}##

avgDaysLateZeroDataLabelFormatter^^'formatter' : function(){
return '0';
}##

avgDaysLateMissingDataLabelFormatter^^'formatter' : function(){
