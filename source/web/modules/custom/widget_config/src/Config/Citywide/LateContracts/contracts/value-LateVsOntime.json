"offset": 30
},
"labels": {
"enabled": true,
"style": {
  "fontFamily": "Roboto, sans-serif",
  "color": "#000",
  "fontSize": "12px",
  "fontWeight": "normal"
},
"y": 20
}
},
  "yAxis": {
    "min": 0,
    "margin": 10,
    "title": {
      "text": "Contract Value",
      "style": {
        "fontSize": "12px",
        "fontFamily": "Roboto, sans-serif",
        "fontWeight": "normal",
        "color": "#000"
      }
    },
    "labels": {
      "function": "yAxisFormatter",
      "style":{"textOverflow":"none"}
    }
  },
"legend": {
"enabled": true,
"reversed": true,
"align": "center",
"verticalAlign": "bottom",
"layout": "horizontal",
