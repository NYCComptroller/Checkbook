"backgroundColor": "rgba(255,255,255,0)",
"margin": [50, 60, 90, 85],
"spacingBottom": 5 // Added extra space at the very bottom
},
  "title": {"text": "", "align": "left"},
"xAxis": {
"categories": [],
"lineColor": "#ccd6eb",
"tickWidth": 0, // This removes the hanging line
"title": {
"text": "Fiscal Year",
"style": {
  "fontSize": "12px",
  "fontFamily": "Roboto, sans-serif",
  "color": "#000",
  "fontWeight": "normal"
},
