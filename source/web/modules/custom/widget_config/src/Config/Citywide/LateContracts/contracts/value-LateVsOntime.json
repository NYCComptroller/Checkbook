    "enabled": false
  },
  "series": [{ "name": "On Time", "data": {"ds":"ontime"}},
    {"name": "Late","data": {"ds":"late"}},
    {"name": "No Data", "data": {"ds":"zero"}}]
}
}

<function>
yAxisFormatter^^'formatter' : function() {
var visible =
this.axis.chart.series[0].visible ||
this.axis.chart.series[1].visible;
return visible ? yAxisLabelFormatter(this) : '';
}##
seriesLabelFormatter^^'formatter' : function () {

if (this.series.name === 'No Data') {

return (
this.series.chart.series[0].visible ||
this.series.chart.series[1].visible
) ? '$0' : '';
}

if (this.y == null) {
return '';
}

return abbrNum(Math.round(Math.abs(this.y)), 0, '$');

}##
tooltipformatter^^'formatter' : function() {
if (!this.points || this.points.length === 0) return '';

var category = this.points[0].point.name;
var fiscalYear = this.points[0].point.fiscal_year;
var onTime = 0;
var late = 0;

this.points.forEach(function (p) {
if (p.series.name === 'On Time') {
onTime = p.y;
} else if (p.series.name === 'Late') {
late = p.y;
}
});

var total = this.points[0].point.total_amount;

return 'Year: FY ' + fiscalYear + '<br/>' +
'On Time: ' + abbrNum(onTime, 2, '$') + '<br/>' +
'Late: ' + abbrNum(late, 2, '$') + '<br/>' +
'Total Contract Amount: ' + abbrNum(total, 2, '$');
}
</function>
