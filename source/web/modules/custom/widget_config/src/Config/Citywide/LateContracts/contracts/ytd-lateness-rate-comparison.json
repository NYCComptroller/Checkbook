{
  "widgetType": "highcharts",
  "widgetSubType": "ajaxSimple",
  "no_results_content": "No Matching Records Found",
  "dataset": "checkbook:aggregateon_contract_retroactivity",
  "neutralRange": {
    "min": -0.001,
    "max": 0.001
  },
  "columns": [
    "year.year",
    "count_ontime_contracts",
    "count_retroactive_contracts"
  ],
  "orderBy": "year.year",
  "cleanURLParameters": [
    "year-end",
    "np-status",
    "agency",
    "vendor",
    "mwbe",
    "industry",
    "mayoral_flag"
  ],
  "urlParamMap": {
    "year-end": "year-end.year-end",
    "np-status": "nonprofit_status.nonprofit_status",
    "agency": "agency_code.agency_code",
    "vendor": "vendor_customer_code.vendor_customer_code",
    "mwbe": "minority_type_id.minority_type_id",
    "industry": "industry_type_id.industry_type_id",
    "mayoral_flag": "mayoral_flag"
  },
  "adjustParameters": "
    return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->adjustParametersFor($parameters, 'ytd-lateness-rate-comparison');
  ",
  "transformationPHP": "
    return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->transformationPHPFor('ytd-lateness-rate-comparison', $node);
  ",
  "template": "retroactivity_ytd_comparison",
  "chartConfig": {
    "chart": {
      "type": "column",
      "height": 500,
      "width": 800,
      "backgroundColor": "rgba(255,255,255,0)",
      "margin": [50, 50, 90, 80],
      "spacingBottom": 5
    },
    "legend": {
      "enabled": true,
      "align": "center",
      "verticalAlign": "bottom",
      "layout": "horizontal",
      "borderWidth": 0,
      "borderRadius": 8,
      "margin": 0,
      "y": 5,
      "itemStyle": {
        "color": "#333333",
        "fontWeight": "normal",
        "fontSize": "12px"
      }
    },
    "xAxis": {
      "categories": [],
      "lineColor": "#ccd6eb",
      "tickWidth": 0,
      "title": {
        "text": "Fiscal Year",
        "style": {"fontSize": "12px", "color": "#333"},
        "offset": 30
      },
      "labels": {
        "enabled": true,
        "style": {"font": "normal 12px Roboto, sans-serif", "color": "#666"},
        "y": 20
      }
    },
    "yAxis": {
      "title": {
        "text": "Late Registration Rate (%)",
        "style": {"fontSize": "12px", "fontFamily": "Roboto, sans-serif"},
        "margin": 10
      },
      "labels": {"align": "right", "x": -5}
    },
    "plotOptions": {
      "column": {
        "minPointLength": 3,
        "dataLabels": {
          "enabled": true,
          "color": "#FFFFFF",
          "align": "center",
          "verticalAlign": "middle",
          "style": {"textOutline": "none", "fontSize": "10px", "fontWeight": "bold"}
        },
        "borderWidth": 1,
        "borderColor": "#FFFFFF"
      },
      "series": {"cursor": "pointer"}
    },
    "series": [],
    "title": {"text": ""}
  }
}
