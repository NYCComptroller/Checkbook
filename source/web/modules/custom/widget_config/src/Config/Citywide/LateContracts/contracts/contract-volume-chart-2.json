}
<function>
yAxisFormatter^^'formatter' : function(){
return Highcharts.numberFormat(this.value, 0, '.', ',');
}##

percentFormatter^^'formatter' : function(){
return this.value + '%';
}##

tooltipFormatter^^'formatter' : function() {
var year = this.point.name.replace('FY', 'FY 20');
if (this.series.type == 'line') {
  return 'Year: ' + year + '<br>% late: ' + Highcharts.numberFormat(this.point.tableValue, 2, '.', ',') + '%';
}

return 'Year: ' + year + '<br># of contracts: ' + Highcharts.numberFormat(this.point.y, 0, '.', ',');
}##
</function>
