            "fontFamily": "Roboto, sans-serif",
            "fontSize": "12px"
          },
          "margin": 5
        },
        "min": 0,
        "max": 20,
        "tickInterval": 4,
        "startOnTick": false,
        "endOnTick": false,
        "labels": {
          "function": "yAxisFormatter",
          "useHTML": false,
          "style": {
            "fontFamily": "Roboto, sans-serif",
            "fontSize": "12px"
          },
          "x": -5
        }
      },
      {
        "title": {
          "text": "% of contracts late",
          "style": {
            "fontFamily": "Roboto, sans-serif",
            "fontSize": "12px"
          }
        },
        "labels": {
          "function": "percentFormatter",
          "style": {
            "fontFamily": "Roboto, sans-serif",
