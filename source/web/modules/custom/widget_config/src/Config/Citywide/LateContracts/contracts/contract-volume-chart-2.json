        "text": "Fiscal Year",
        "align": "middle",
        "x": -10,
        "offset": 30,
        "y": -3,
        "style": {
          "fontFamily": "Roboto, sans-serif",
          "fontSize": "12px",
          "fontWeight": "normal",
          "color": "#000"
        }
      },
      "labels": {
        "enabled": true,
        "useHTML": true,
        "y": 20,
