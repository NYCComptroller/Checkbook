        "opposite": true,
        "min": 0,
        "max": 100,
        "tickInterval": 20,
        "gridLineWidth": 0,
        "startOnTick": false,
        "endOnTick": false
      }
    ],
    "tooltip": {
      "function": "tooltipFormatter",
      "shared": false,
      "useHTML": false,
      "shape": "rect",
      "backgroundColor": "#FFFFFF",
      "borderWidth": 1,
      "borderRadius": 2,
      "shadow": true,
      "padding": 8,
      "style": {
        "fontFamily": "Roboto, sans-serif",
        "fontSize": "12px",
