      },
      {
        "colLabel": "On Time",
        "column": "count_ontime_contracts"
      },
      {
        "colLabel": "Retroactive",
        "column": "count_retroactive_contracts"
      }
    ]
  },
  "dataset": "checkbook:aggregateon_contract_retroactivity",
  "columns": [
    "year.year",
    "count_ontime_contracts",
    "count_retroactive_contracts"
  ],
  "orderBy": "year.year",
  "cleanURLParameters": [
    "year-start",
    "year-end",
    "np-status",
    "agency",
    "vendor",
    "mwbe",
    "industry",
    "mayoral_flag"
  ],
  "urlParamMap": {
    "year-start": "year-start.year-start",
    "year-end": "year-end.year-end",
    "np-status": "nonprofit_status.nonprofit_status",
    "agency": "agency_code.agency_code",
    "vendor": "vendor_customer_code.vendor_customer_code",
    "mwbe": "minority_type_id.minority_type_id",
    "industry": "industry_type_id.industry_type_id",
    "mayoral_flag": "mayoral_flag"
  },
  "adjustParameters": "
  return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->adjustParametersFor($parameters, 'contract-volume-chart-2');
  ",
  "transformationPHP": "
  return \\Drupal::service('checkbook_widget_retroactivity.retroactivity_filter_processor')->transformationPHPFor('contract-volume-chart-2', $node);
  ",
