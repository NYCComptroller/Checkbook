      "margin": 0,
      "backgroundColor": "rgba(255,255,255,0)",
      "symbolWidth": 12,
      "symbolHeight": 12,
      "symbolRadius": 0,
      "itemDistance": 20,
      "itemStyle": {
        "fontFamily": "Roboto, sans-serif",
        "fontSize": "12px",
        "fontWeight": "normal",
        "color": "#000"
      },
      "itemHoverStyle": {
        "color": "#333333"
      }
    },
    "xAxis": {
      "categories": [],
      "lineColor": "#ccd6eb",
      "tickWidth": 0,
