{% macro item(label, link, dollar_amount, count, active_class, tab_style, tooltip, indicator = true) %}
  <div class="bottom-navigation--item {{ active_class }} {{ tab_style }}">
  {% set formatted_label = label|raw | striptags %}
    {% if(item.tooltip|length > 0) %}
        <div class="activeExpenseContractNote toolTip">
          {{ item.tooltip }}
        </div>
    {% endif %}
    {% if link == false %}
      <div aria-label="{{ count }} {{ formatted_label }} Contracts {{ dollar_amount }}" class="bottom-navigation--item-label">
        <span aria-hidden="true" class="bottom-navigation--item-count">
          {{ count }}
        </span>
        <span aria-hidden="true" class="bottom-nav-domain-label">{{ label|raw }} Contracts</span>
        <span aria-hidden="true" class="bottom-navigation--item-dollar_amount">
          {{ dollar_amount }}
        </span>
      </div>
    {% else %}
      <a aria-label="{{ count }} {{ formatted_label }} Contracts {{ dollar_amount }}" class="bottom-navigation--item-label display-block text-no-underline" href="{{ link }}">
        <span aria-hidden="true" class="bottom-navigation--item-count">
          {{ count }}
        </span>
        <span aria-hidden="true" class="bottom-nav-domain-label">{{ label|raw }} Contracts</span>
        <span aria-hidden="true" class="bottom-navigation--item-dollar_amount">
          {{ dollar_amount }}
        </span>
      </a>
    {% endif %}

    {# Show indicator if item is active or by force (indicator == true in array) #}
    {% if (active_class|length > 0) and active_class != 'disable_me' %}
      <div class="indicator-active"></div>
    {% endif %}
  </div>
{% endmacro item %}

{% set render = generateContractsBottomSlider(node) | raw %}
{% set first_section = render['bottom_navigation'] %}

<div class="contracts bottom-navigation">
  <!-- Items -->
  <div class="display-flex flex-justify">
    <div class="display-flex bottom-navigation--section">
      {% for item in first_section %}
        {{ _self.item(item.label, item.link, item.dollar_amount, item.count, item.active_class, item.tab_style, item.tooltip) }}
      {% endfor %}
    </div>
  </div>
</div>
