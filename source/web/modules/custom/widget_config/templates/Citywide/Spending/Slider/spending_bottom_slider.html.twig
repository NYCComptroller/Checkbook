{% macro item(label, dollar_amount, link, active_class, indicator) %}
  <div class="bottom-navigation--item {{ active_class }}" aria-label="{{label | striptags}} Spending {{ dollar_amount }} link" role="tab">
  {% set formatted_label = label | replace({' ': '&', '/': '-'}) %}
    {% if link == false %}
    <div aria-labelledby="bottom-nav-spending-{{ formatted_label }}-label bottom-nav-spending-{{ formatted_label }}-domain bottom-nav-spending-{{ formatted_label }}-amount" class="bottom-navigation--item-label">
      <span id="bottom-nav-spending-{{ formatted_label }}-label">{{ label }}</span>
      <span id="bottom-nav-spending-{{ formatted_label }}-domain" class="bottom-nav-domain-label">Spending</span>
      <span id="bottom-nav-spending-{{ formatted_label }}-amount" class="bottom-navigation--item-dollar_amount">
        {{ dollar_amount }}
      </span>
    </div>
    {% else %}
      <a aria-labelledby="bottom-nav-spending-{{ formatted_label }}-label bottom-nav-spending-{{ formatted_label }}-domain bottom-nav-spending-{{ formatted_label }}-amount" class="bottom-navigation--item-label display-block text-no-underline" href="{{ link }}">
      <span id="bottom-nav-spending-{{ formatted_label }}-label">{{ label }}</span>
      <span id="bottom-nav-spending-{{ formatted_label }}-domain" class="bottom-nav-domain-label">Spending</span>
      <span id="bottom-nav-spending-{{ formatted_label }}-amount" class="bottom-navigation--item-dollar_amount">
        {{ dollar_amount }}
      </span>
      </a>
    {% endif %}

    {# Show indicator if item is active or by force (indicator == true in array) #}
    {% if indicator == true or active_class|length > 0 %}
      <div class="indicator-active"></div>
    {% endif %}
  </div>
{% endmacro item %}

{% set render = generateSpendingBottomSlider(node) | raw %}
{% set first_section = render['bottom_navigation'] %}

<div class="bottom-navigation">
  <!-- Items -->
  <div class="display-flex flex-justify">
    <div class="display-flex bottom-navigation--section">
      {% for item in first_section %}
        {{ _self.item(item.label, item.dollar_amount, item.link, item.active_class) }}
      {% endfor %}
    </div>
  </div>
</div>
