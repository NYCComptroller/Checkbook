{
    "heading": "Late Contracts Dashboard",
    "subHeading": "<h2>Tracking Contract Registration Delays and Their Impact on Timely Payment</h2>",
    "retainFilters": false,
    "defaultYearInterval": 3,
    "defaultYearCount": 16,
    "minBarWidth": 33,
    "maxBarWidth": 85,
    "yearlyProgressionRateForBar": 2,
    "excludeAgencyAutocomplete": [
        "health and hospitals corporation[ hhc ][ 819 ]"
    ],
    "excludeVendorAutocomplete": [
        "new york city housing authority[ 0000947209 ]"
    ],
    "tabs": {
        "overview": {
            "label": "Overview",
            "enabled": true,
            "order": 1,
            "tiles_enabled": false
        },
        "contract_volume": {
            "label": "Contract Volume",
            "enabled": true,
            "tiles_enabled": true,
            "order": 2,
            "tiles": [
                "contract_volume_chart_1",
                "contract_volume_chart_2",
                "contract_volume_chart_3",
                "contract_volume_chart_4"
            ]
        },
        "contract_value": {
            "label": "Contract Value",
            "enabled": true,
            "tiles_enabled": true,
            "order": 3,
            "tiles": [
                "contract_value_chart_1"
            ]
        },
        "average_days_late": {
            "label": "Average Days Late",
            "enabled": true,
            "tiles_enabled": true,
            "order": 4,
            "tiles": [
                "average_days_late_1",
                "average_days_late_2"
            ]
        },
        "payment": {
            "label": "Payments",
            "enabled": false,
            "tiles_enabled": true,
            "order": 5,
