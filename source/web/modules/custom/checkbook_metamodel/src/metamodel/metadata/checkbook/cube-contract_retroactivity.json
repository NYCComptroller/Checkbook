                },
                "total_contracts_sum": {
                  "function": "SUM(total_contracts)"
                },
                "all_years": {
                    "function": "DISTINCT year"
                },
                "avg_days_late": {
                    "function": "round(SUM(total_days_delta) / SUM(total_contracts), 0)"
                },
                "lateness_label": {
                    "function": "CASE WHEN round(SUM(total_days_delta) / SUM(total_contracts), 0) > 0 THEN 'late' ELSE 'ontime' END"
